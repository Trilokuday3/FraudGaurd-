MLFLOW_TRACKING_URI=./mlruns
MLFLOW_RUN_ID=
DECISION_DB_URL=sqlite:///./decisions.db
THRESHOLDS_PATH=./decision/thresholds.json
# Set to the deployed Vercel URL (e.g. https://fraudguard.vercel.app) in production only
DEPLOYED_FRONTEND_ORIGIN=
ENABLE_REPLAY_WORKER=false
REPLAY_INTERVAL_SECONDS=7.0

# Live streaming pipeline (Kafka + Spark) -- only needed when running
# streaming/producer.py or streaming/spark_consumer.py locally against
# the Aiven Kafka service; not read by serving/app.py. The three PEM values
# are the *contents* of Aiven's ca.pem / service.cert / service.key (in CI
# they are GitHub secrets). Never commit the key files themselves.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CA_CERT=
KAFKA_SERVICE_CERT=
KAFKA_SERVICE_KEY=
KAFKA_TOPIC=fraudguard.transactions
SPARK_CHECKPOINT_DIR=./spark-checkpoint
PRODUCER_BATCH_SIZE=30
